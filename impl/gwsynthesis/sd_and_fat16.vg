module top (
  clk,
  rst_n,
  uart_tx,
  sd_spi_miso,
  sd_spi_mosi,
  sd_spi_sck,
  sd_spi_cs
)
;
input clk;
input rst_n;
output uart_tx;
input sd_spi_miso;
output sd_spi_mosi;
output sd_spi_sck;
output sd_spi_cs;
wire clk_d;
wire rst_n_d;
wire uart_tx_d;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  OBUF uart_tx_obuf (
    .O(uart_tx),
    .I(uart_tx_d) 
);
  TBUF sd_spi_mosi_s0 (
    .O(sd_spi_mosi),
    .I(GND),
    .OEN(VCC) 
);
  TBUF sd_spi_sck_s0 (
    .O(sd_spi_sck),
    .I(GND),
    .OEN(VCC) 
);
  TBUF sd_spi_cs_s0 (
    .O(sd_spi_cs),
    .I(GND),
    .OEN(VCC) 
);
  uart_tx debug_tx (
    .clk_d(clk_d),
    .rst_n_d(rst_n_d),
    .uart_tx_d(uart_tx_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
