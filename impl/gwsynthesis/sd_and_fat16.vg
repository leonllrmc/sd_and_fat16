module gw_gao (
  tms_pad_i,
  tck_pad_i,
  tdi_pad_i,
  clk_d,
  sdCmd_1_1,
  sdCmd_2_2,
  sd_cmd_busy,
  sdCmd_3_2,
  sdCmd_4_2,
  sdCmd_5_2,
  sdCmd_6_2,
  sdCmd_0_4,
  sd_cmd_send_pulse,
  tdo_pad_o
)
;
input tms_pad_i;
input tck_pad_i;
input tdi_pad_i;
input clk_d;
input sdCmd_1_1;
input sdCmd_2_2;
input sd_cmd_busy;
input sdCmd_3_2;
input sdCmd_4_2;
input sdCmd_5_2;
input sdCmd_6_2;
input sdCmd_0_4;
input sd_cmd_send_pulse;
output tdo_pad_o;
wire tms_i_c;
wire tck_i_c;
wire tdi_i_c;
wire tdo_o_c;
wire gao_jtag_tdi;
wire gao_jtag_reset;
wire run_test_idle_er1;
wire run_test_idle_er2;
wire shift_dr_capture_dr;
wire pause_dr;
wire enable_er1;
wire enable_er2;
wire tdo_er1;
wire n12_6;
wire n20_4;
wire module_next_state_1_45;
wire module_next_state_0_36;
wire module_next_state_1_48;
wire crc_serial_out;
wire [5:0] control0;
wire [4:2] control0_0;
wire [3:0] module_id_reg;
wire [3:0] module_state;
wire [0:0] data_out_shift_reg;
wire VCC;
wire GND;
  IBUF tms_ibuf (
    .O(tms_i_c),
    .I(tms_pad_i) 
);
  IBUF tck_ibuf (
    .O(tck_i_c),
    .I(tck_pad_i) 
);
  IBUF tdi_ibuf (
    .O(tdi_i_c),
    .I(tdi_pad_i) 
);
  OBUF tdo_obuf (
    .O(tdo_pad_o),
    .I(tdo_o_c) 
);
//black box: GW_JTAG u_gw_jtag
  GW_JTAG u_gw_jtag (
    .tck_pad_i(tck_i_c),
    .tms_pad_i(tms_i_c),
    .tdi_pad_i(tdi_i_c),
    .tdo_er1_i(tdo_er1),
    .tdo_er2_i(GND),
    .tdo_pad_o(tdo_o_c),
    .tck_o(control0[0]),
    .tdi_o(gao_jtag_tdi),
    .test_logic_reset_o(gao_jtag_reset),
    .run_test_idle_er1_o(run_test_idle_er1),
    .run_test_idle_er2_o(run_test_idle_er2),
    .shift_dr_capture_dr_o(shift_dr_capture_dr),
    .pause_dr_o(pause_dr),
    .update_dr_o(control0[5]),
    .enable_er1_o(enable_er1),
    .enable_er2_o(enable_er2) 
);
  gw_con_top u_icon_top (
    .shift_dr_capture_dr(shift_dr_capture_dr),
    .enable_er1(enable_er1),
    .gao_jtag_tdi(gao_jtag_tdi),
    .n20_4(n20_4),
    .module_next_state_0_36(module_next_state_0_36),
    .module_next_state_1_48(module_next_state_1_48),
    .crc_serial_out(crc_serial_out),
    .module_next_state_1_45(module_next_state_1_45),
    .gao_jtag_reset(gao_jtag_reset),
